APP_NAME="Dwarkesh Bakers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dwarkesh-backers.up.railway.app

APP_LOCALE=gu
APP_FALLBACK_LOCALE=gu
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.227.204.112:3000
CORS_SUPPORTS_CREDENTIALS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

IMAGE_DISK=public
IMAGE_BASE_URL=https://dwarkesh-backers.up.railway.app/storage
SUPPORT_IMAGE_DISK=local

CUSTOMER_OTP_DRIVER=sms

MAIL_MAILER=log
MAIL_FROM_NAME="Dwarkesh Bakers"

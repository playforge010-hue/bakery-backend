APP_NAME="Dwarkesh Bakers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_LOCALE=gu
APP_FALLBACK_LOCALE=gu

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dwarkesh_bakers
DB_USERNAME=dwarkesh_app
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com
CORS_SUPPORTS_CREDENTIALS=false

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
IMAGE_DISK=public
IMAGE_BASE_URL=https://api.example.com/storage
SUPPORT_IMAGE_DISK=local

# Replace with a supported SMS provider before production customer login is enabled.
CUSTOMER_OTP_DRIVER=sms

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://www.example.com,https://example.com

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME="Dwarkesh Bakers"
